# --- raw data: too large for GitHub, or externally sourced -------------------
# The Access database is ~108 MB, over GitHub's 100 MB hard per-file limit.
# It cannot be committed without Git LFS. Keep it out of the repository and
# share it separately (see README).
data-raw/*.accdb
data-raw/*.laccdb
data-raw/*.mdb

# WDPA protected-area extract: ~14 MB, redownloadable from protectedplanet.net.
# Second pattern covers the folder before it is moved under data-raw/.
data-raw/wdpa/
WDPA_WDOECM_*/

# --- derived data: regenerated by the scripts --------------------------------
data/*.RDS
data/lion_sighting_points.csv

# sighting_protection.csv is deliberately NOT ignored. It is small (~37 KB) and
# is the one derived file that cannot be rebuilt without the WDPA download, so
# committing it keeps the pipeline runnable from the Access database alone.

# --- model output ------------------------------------------------------------
output/*.RDS
output/*.pdf
output/*.csv

# --- archive: superseded scripts and data bundles ----------------------------
archive/*.RDS

# --- R ------------------------------------------------------------------------
.Rproj.user/
.Rhistory
.RData
.Ruserdata
.Renviron
Rplots.pdf
*.Rcheck/
.httr-oauth

# --- JAGS ---------------------------------------------------------------------
CODA*.txt
codaIndex.txt
jagsdata.txt
jagsinits*.txt
jagsscript.txt
samplers.txt

# --- OS -----------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
~$*

# --- Quarto -------------------------------------------------------------------
.quarto/
reports/*_files/
# The rendered report is self-contained (embed-resources) and is the artefact
# collaborators actually read, so reports/ipm_report.html stays tracked.

/.quarto/
**/*.quarto_ipynb
